{
  "name": "ai-agent-book-ts",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript implementations for AI Agent Book examples",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "start:context": "pnpm --filter @ai-agent-book/chapter1-context start",
    "start:web-search": "pnpm --filter @ai-agent-book/chapter1-web-search-agent start",
    "experiment:web-search": "pnpm --filter @ai-agent-book/chapter1-web-search-agent experiment",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.10.1"
  }
}
